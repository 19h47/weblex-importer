<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	convertDeprecationsToExceptions="true"
>
	<testsuites>
		<testsuite name="Weblex Importer">
			<directory prefix="class-test-" suffix=".php">tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
