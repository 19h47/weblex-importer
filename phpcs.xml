<?xml version="1.0"?>
<ruleset name="Weblex-Importer-Standards">
    <description>WordPress standards for the Weblex Importer plugin.</description>

    <file>.</file>

    <arg name="extensions" value="php" />

    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <rule ref="WordPress" />

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="webleximporter" />
            </property>
        </properties>
    </rule>
</ruleset>
